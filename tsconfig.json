{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "jsx": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "*.tsx",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "*_1.ts",
    "*_1.tsx"
  ]
}
